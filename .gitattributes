# ============================================================
# Базовые настройки
# ============================================================

# Автоматически определяем текстовые файлы
* text=auto

# ============================================================
# Текстовые файлы с LF
# ============================================================

# Python
*.py text eol=lf

# Markdown / текст / конфиги
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# ============================================================
# Shell-скрипты обязательно LF
# ============================================================

# Важно для Linux/macOS/WSL
*.sh text eol=lf

# ============================================================
# Windows-скрипты — CRLF
# ============================================================

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ============================================================
# Бинарные файлы
# ============================================================

# Изображения
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.webp binary

# Документы
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Архивы и исполняемые файлы
*.zip binary
*.rar binary
*.7z binary
*.tar binary
*.gz binary
*.bz2 binary
*.xz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pyd binary

# ============================================================
# Дополнительно
# ============================================================

# Git не должен пытаться сливать эти файлы как текст
*.lock binary